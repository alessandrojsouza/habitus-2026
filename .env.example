# ==========================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE - HABITUS
# Renomeie este arquivo para .env no ambiente local ou servidor
# ==========================================

SECRET_KEY=sua_secret_key_super_segura_aqui_com_mais_de_50_caracteres
DEBUG=True

# Banco de Dados (PostgreSQL):
# - Para rodar via Docker Compose (já configurado no docker-compose.yml):
#   DATABASE_URL=postgres://habitus:habituspassword@db:5432/habitus
# - Para rodar localmente fora do container conectando no Postgres:
#   DATABASE_URL=postgres://habitus:habituspassword@localhost:5432/habitus
# - Se não definida, utilizará o SQLite local padrão em devadmin/data/db.sqlite3
DATABASE_URL=postgres://habitus:habituspassword@localhost:5432/habitus

# Backend de Email:
# Em dev: django.core.mail.backends.console.EmailBackend
# Em prod/SMTP: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

EMAIL_HOST_USER=seu_email_remetente@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_app_16_letras_do_google
DEFAULT_FROM_EMAIL=seu_email_remetente@gmail.com

ALLOWED_HOSTS=localhost,127.0.0.1,*
SITE_URL=http://localhost:8000
